# EnvHaven Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control!

# ===================
# Core Settings
# ===================
PUID=1000
PGID=1000
TZ=America/New_York
DEFAULT_WORKSPACE=/config/workspace

# ===================
# Authentication (REQUIRED)
# ===================
# Web GUI password - set a strong password.
# Also gates the browser terminal on port 7681. If neither this nor
# HASHED_PASSWORD is set, the browser terminal stays closed and the web UI
# listens on 127.0.0.1 inside the container only (reach it through SSH).
PASSWORD=

# Sudo password - set a strong password. SSH does not accept passwords.
SUDO_PASSWORD=

# Or use hashed passwords for better security:
# HASHED_PASSWORD=       # Generate: echo -n "pass" | npx argon2-cli -e
# SUDO_PASSWORD_HASH=    # Generate: openssl passwd -6

# ===================
# SSH Configuration
# ===================
# SSH accepts keys only. To load all your GitHub public keys (https URLs only), uncomment the
# line below and put your GitHub username in place of the angle brackets. Whoever owns the
# account the URL names can sign in, so leave it commented until it names yours.
# PUBLIC_KEY_URL=https://github.com/<your-github-username>.keys

# Alternative: Paste a specific public key directly
# PUBLIC_KEY=ssh-ed25519 AAAA... user@host

# Alternative: Mount a directory of key files
# PUBLIC_KEY_DIR=/config/.ssh/authorized_keys.d

# ===================
# AI Tool API Keys
# ===================
# Set the keys for the AI tools you want to use.
# Leave empty if not using that tool.

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# MISTRAL_API_KEY=

# See SKILL.md Step 4 and TOOLS.md → "WhatsApp ↔ Claude Code bridge" for the role model.
# All three role values are LIDs (15-digit WhatsApp identifiers, not phone numbers).
# Bridge re-reads this file on every message; no restart on edit.

# Single LID. Full trust + can mutate the whitelist via natural language.
OWNER_LID=

# Comma-separated full-trust LIDs. Same powers as owner, except whitelist edits.
# `BOOTSTRAP` is the install-time placeholder so the bridge can boot before Step 7.
WHITELIST_NUMBERS=BOOTSTRAP

# Comma-separated read-only LIDs. Bash/Edit/Write/NotebookEdit refused on their behalf.
RESTRICTED_LIDS=

# Workspace the SDK operates in (Read/Edit/Bash see this dir). Usually the project root.
CLAUDE_CWD=

# Optional: model override (e.g. claude-sonnet-4-6).
CLAUDE_MODEL=

# Hour of day (0-23, local time) for the daily session reset + memory flush.
DAILY_RESET_HOUR=5

# IANA timezone for cron schedules in data/crons.json (e.g. America/Montevideo,
# Europe/Madrid, Asia/Tokyo). Empty = system timezone.
CRON_TIMEZONE=

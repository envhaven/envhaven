# See SKILL.md Step 4 and TOOLS.md → "WhatsApp ↔ Claude Code bridge" for the role model.
# Both role values are LIDs (15-digit WhatsApp identifiers, not phone numbers).
# Bridge re-reads this file on every message; no restart on edit.

# The single owner LID. The owner is the ONLY principal that runs with mutating tools
# (Bash/Edit/Write) and the only one that can change the whitelist or allow a group
# via natural language. `BOOTSTRAP` is the install-time placeholder so the bridge can
# boot before Step 7 captures the real LID; it matches no real sender, so the bot
# ignores everyone until you set the real owner.
OWNER_LID=BOOTSTRAP

# Comma-separated guest LIDs: read-only. Each guest turn runs with only the read tools
# (Read, Glob, Grep, WebFetch, WebSearch), confined by a hook to the workspace and the
# chat's own attachments. No Bash/Edit/Write, no access to the bridge's own config,
# credentials, or other chats. Guests cannot allow groups or schedule crons.
GUEST_LIDS=

# Workspace the SDK operates in (Read/Edit/Bash see this dir); usually the project root.
# MUST live outside the bridge directory: guest reads are confined to this dir, so the
# bridge's own .env/auth/data must not sit inside it. The installer sets this; the bridge
# refuses to start if it is empty or overlaps the bridge dir.
CLAUDE_CWD=

# Optional: model override (e.g. claude-sonnet-4-6).
CLAUDE_MODEL=

# Hour of day (0-23, local time) for the daily session reset + memory flush.
DAILY_RESET_HOUR=5

# IANA timezone for cron schedules in data/crons.json (e.g. America/Montevideo,
# Europe/Madrid, Asia/Tokyo). Empty = system timezone.
CRON_TIMEZONE=

# Skip the daily flush for a chat still active within this window (milliseconds).
# Avoids interrupting a live conversation. Default 900000 (15 min).
FLUSH_IDLE_THRESHOLD_MS=900000

# Git
.git
.gitignore

# GitHub (not needed in image)
.github

# Documentation (not needed in image)
docs/
*.md

# Dependencies (reinstalled in-image from lockfiles; never copied from context)
# `**` matches any number of directories INCLUDING ZERO, so this one pattern
# also covers a root-level node_modules.
**/node_modules

# Extension build artifacts (source is copied, not artifacts), the same set .gitignore
# excludes. A stale webview/build is not inert: Tailwind scans it for class names, so a
# checkout that had built the extension baked unused CSS into the image.
extension/out
extension/dist
extension/*.vsix
extension/tsconfig.tsbuildinfo
extension/webview/build
extension/webview/dist
extension/webview/.vite
extension/webview/tsconfig.tsbuildinfo

# Console build artifact (rebuilt in Docker; churns via the dev test loop)
console/console

# Test scripts and Playwright output (not needed in image)
test/
**/test-results

# Editor/IDE
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# No longer generated. Kept so checkouts that predate its removal don't ship a
# few hundred MB of container HOME to the daemon on every build.
.test-config

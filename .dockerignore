# Git
.git
.gitignore

# GitHub (not needed in image)
.github

# Documentation (not needed in image)
docs/
*.md

# Dependencies (reinstalled in-image from lockfiles; never copied from context)
# `**` matches any number of directories INCLUDING ZERO, so this one pattern
# also covers a root-level node_modules.
**/node_modules

# Extension build artifacts (source is copied, not artifacts)
extension/out
extension/*.vsix

# Console build artifact (rebuilt in Docker; churns via the dev test loop)
console/console

# Test scripts (not needed in image)
test/

# Editor/IDE
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Test config (generated by eh dev tools)
.test-config

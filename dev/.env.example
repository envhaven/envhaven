# EnvHaven Development Configuration
# Copy to .env.dev and customize for your environment
#
# Precedence: exported environment variable > this file > built-in default. So a one-off
# override needs no edit here:  ENVHAVEN_IMAGE=envhaven:test bun scripts/test-image.ts
# It also means a variable inherited from a surrounding container wins. ENVHAVEN_SSH_PORT
# is the one to watch: a managed workspace exports it, and scripts/start.ts publishes
# whatever it resolves to, so developing on EnvHaven from inside EnvHaven can bind a
# different host port than the one set here.

# Container settings
ENVHAVEN_CONTAINER_NAME=envhaven-test
ENVHAVEN_IMAGE=envhaven:dev
ENVHAVEN_WEB_PORT=8443
ENVHAVEN_SSH_PORT=2222
# Browser terminal (xterm.js on 7681); opens because ENVHAVEN_PASSWORD is set below
ENVHAVEN_CONSOLE_PORT=7681
ENVHAVEN_PASSWORD=test

# Host to connect to (localhost for local Docker, IP for remote)
ENVHAVEN_HOST=localhost

# Host path to this repo (required for extension live-dev inside a container)
#
# The Docker daemon runs on the host and can't see paths inside your container.
# This path is used to mount extension source for live development, so only the
# Watch Extension action needs it. Build, start, test, logs and shell work without.
#
# Find it by checking where your container's workspace is mounted from.
#
# Example: /home/user/projects/envhaven
ENVHAVEN_HOST_REPO_PATH=

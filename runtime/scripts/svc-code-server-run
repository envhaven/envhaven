#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# LinuxServer's svc-code-server run script with two changes. The Dockerfile checks the base
# image's original against a recorded hash before replacing it, so a change upstream stops the
# build instead of being silently overwritten by this copy.
#
#   - code-server starts through as-abc, which hands it the workspace user's environment (HOME
#     and the tool PATH) and none of the secrets only root services read. Root's own PATH holds
#     no directory abc can write; the readiness probe below runs as root and relies on that.
#     as-abc also covers LinuxServer's non-root mode, so the original's two branches are one.
#   - With no web password, code-server listens on loopback only. An editor with no login is a
#     shell, and the reference docker-compose.yml publishes 8443 on every interface. Reach it
#     through an SSH tunnel, or set PASSWORD or HASHED_PASSWORD.

if [[ -n "${PASSWORD}" ]] || [[ -n "${HASHED_PASSWORD}" ]]; then
    AUTH="password"
else
    AUTH="none"
    echo "starting with no password"
fi

if [[ -z ${PROXY_DOMAIN+x} ]]; then
    PROXY_DOMAIN_ARG=""
else
    PROXY_DOMAIN_ARG="--proxy-domain=${PROXY_DOMAIN}"
fi

if [[ -z ${PWA_APPNAME} ]]; then
    PWA_APPNAME="code-server"
fi

if [[ "${AUTH}" == "none" ]]; then
    BIND_ADDR="127.0.0.1:8443"
    echo "no PASSWORD or HASHED_PASSWORD is set: code-server listens on 127.0.0.1 only"
elif test -f /proc/net/if_inet6; then
    BIND_ADDR="[::]:8443"
else
    BIND_ADDR="0.0.0.0:8443"
fi

exec \
    s6-notifyoncheck -d -n 300 -w 1000 -c "nc -z 127.0.0.1 8443" \
        /usr/local/lib/envhaven/as-abc \
            /app/code-server/bin/code-server \
                --bind-addr "${BIND_ADDR}" \
                --user-data-dir /config/data \
                --extensions-dir /config/extensions \
                --disable-telemetry \
                --auth "${AUTH}" \
                --app-name "${PWA_APPNAME}" \
                "${PROXY_DOMAIN_ARG}" \
                "${DEFAULT_WORKSPACE:-/config/workspace}"

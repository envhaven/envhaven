#!/usr/bin/with-contenv bash

# Link the extensions baked into the image into the extensions directory code-server uses.
#
# linuxserver/code-server runs with --extensions-dir /config/extensions, so that is where
# they must appear. The EnvHaven extension is installed at build time into
# /app/pre-installed-extensions and symlinked here at runtime to survive volume mounts.
# Nothing is fetched from a marketplace at boot: whatever ships is reviewed with the image.
#
# Writes inside /config, abc's home, so it runs as abc: a root write there follows whatever
# links abc left behind. bash reads this file directly on the way back in, because with-contenv
# itself must run as root.
if (( EUID == 0 )); then
    exec /usr/local/lib/envhaven/as-abc /bin/bash "$0"
fi

EXTENSIONS_DIR="/config/extensions"
PRE_INSTALLED_DIR="/app/pre-installed-extensions"

mkdir -p "$EXTENSIONS_DIR"

if [ -d "$PRE_INSTALLED_DIR" ]; then
    for ext in "$PRE_INSTALLED_DIR"/*; do
        [ -d "$ext" ] || continue
        extname=$(basename "$ext")
        target="$EXTENSIONS_DIR/$extname"
        # The EnvHaven extension is always re-linked, so an image update reaches it.
        if [[ "$extname" == envhaven.* ]]; then
            ln -sfn "$ext" "$target"
            echo "EnvHaven extension linked: $extname"
        elif [ ! -e "$target" ]; then
            ln -s "$ext" "$target"
            echo "Linked: $extname"
        else
            echo "Skipping $extname (already exists)"
        fi
    done
fi

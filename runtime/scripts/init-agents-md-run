#!/usr/bin/with-contenv bash

AGENTS_FILE="/config/workspace/AGENTS.md"
CLAUDE_FILE="/config/workspace/CLAUDE.md"

mkdir -p /config/workspace
chown abc:abc /config/workspace

mkdir -p /config/go
chown -R abc:abc /config/go

if [ ! -f "$AGENTS_FILE" ]; then
    export USER_NAME="abc"
    export WORKSPACE_PATH="/config/workspace"
    envsubst < /defaults/AGENTS.md.template > "$AGENTS_FILE"
    if [ "${ENVHAVEN_MANAGED:-false}" = "true" ]; then
        # Substitute only the display URLs. The managed template also contains literal
        # $_ENVHAVEN_API_URL / $_ENVHAVEN_WORKSPACE_ID / $_ENVHAVEN_WORKSPACE_TOKEN references
        # that the agent expands from its own environment at call time; keeping them out of the
        # allowlist leaves them verbatim, so the workspace token is never written into AGENTS.md.
        envsubst '$_ENVHAVEN_PUBLIC_URL $_ENVHAVEN_PREVIEW_URL $_ENVHAVEN_WORKSPACE_NAME $ENVHAVEN_SSH_HOST' \
            < /defaults/AGENTS.md.managed.template >> "$AGENTS_FILE"
    else
        envsubst < /defaults/AGENTS.md.selfhosted.template >> "$AGENTS_FILE"
    fi
    chown abc:abc "$AGENTS_FILE"
    echo "AGENTS.md generated (managed=${ENVHAVEN_MANAGED:-false})"
else
    echo "AGENTS.md exists, skipping"
fi

if [ ! -e "$CLAUDE_FILE" ] && [ ! -L "$CLAUDE_FILE" ]; then
    ln -s AGENTS.md "$CLAUDE_FILE"
    chown -h abc:abc "$CLAUDE_FILE"
    echo "CLAUDE.md → AGENTS.md (symlink)"
elif [ -f "$CLAUDE_FILE" ] && [ ! -L "$CLAUDE_FILE" ] && cmp -s "$AGENTS_FILE" "$CLAUDE_FILE"; then
    ln -sf AGENTS.md "$CLAUDE_FILE"
    chown -h abc:abc "$CLAUDE_FILE"
    echo "CLAUDE.md → AGENTS.md (migrated from copy)"
else
    echo "CLAUDE.md exists, skipping"
fi

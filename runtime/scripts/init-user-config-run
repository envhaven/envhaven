#!/usr/bin/with-contenv bash

# Root half of the workspace user's boot setup: only what needs root runs here. Everything that
# writes inside /config runs as abc, in envhaven-user-setup at the end, because /config is abc's
# home and a root write there follows whatever links abc left in it.

# Docker access, for Plus/Pro workspaces and self-hosters who mount the host's socket: abc joins
# the group that owns the socket. s6-setuidgid takes supplementary groups from the group
# database, so this membership is what code-server, the console and SSH sessions actually get;
# docker run's --group-add does not survive the switch to abc. The socket's own mode is left
# alone, with the one exception below: it is the host's file, and a world-writable socket makes
# every process on the host a Docker client. LinuxServer's Docker mod does the same.
if [ -S /var/run/docker.sock ]; then
    # Images before 1.9.0 ran `chmod 666` on the socket at every boot, and the host keeps that
    # mode until dockerd recreates the socket, so a managed host updated from one of them would
    # still let every process on it reach Docker, the cloudflared connector in this container
    # included. A managed host's socket serves this workspace alone, so there the mode goes back
    # to the daemon's 660, and abc keeps access through the group it joins below. A self-hosted
    # socket may be shared with other containers that rely on its mode, so it stays as the host
    # left it. Remove this once every managed host has rebooted since it last ran an image older
    # than 1.9.0.
    if [ "${ENVHAVEN_MANAGED:-}" = "true" ] && [ "$(stat -c %a /var/run/docker.sock)" = 666 ]; then
        chmod 660 /var/run/docker.sock && echo "Docker: set the socket's mode back to 660"
    fi
    DOCKER_GID=$(stat -c %g /var/run/docker.sock)
    DOCKER_GROUP=$(getent group "$DOCKER_GID" | cut -d: -f1)
    if [ -z "$DOCKER_GROUP" ]; then
        DOCKER_GROUP="docker-$DOCKER_GID"
        groupadd -g "$DOCKER_GID" "$DOCKER_GROUP"
    fi
    usermod -aG "$DOCKER_GROUP" abc && echo "Docker: abc joined group $DOCKER_GROUP ($DOCKER_GID)"
fi

# Ensure installed tools are writable by abc for runtime updates (npm install -g, mise install,
# etc.). Launch-policy wrappers stay image-owned; users override them through /config/.local/bin.
# Runs in background to avoid blocking startup and changes only files not already owned by abc.
/usr/local/lib/envhaven/envhaven-repair-tool-ownership &

# A tool once run as root can leave root-owned files in abc's XDG directories and Go module
# cache, which then break that tool for abc. ~/.ssh is listed too: LinuxServer's init-code-server
# recreates it as root whenever it is missing, and envhaven-user-setup writes authorized_keys
# there as abc, so a directory or key file abc cannot read or write would drop keys. chown -R
# follows neither a symlink given as its argument nor one it meets inside the tree, and each of
# these is a direct child of the mounted /config, a path abc cannot swap out from under it.
for dir in /config/.local /config/.config /config/.cache /config/go /config/.ssh; do
    [ -e "$dir" ] && chown -R abc:abc "$dir"
done

# LinuxServer's init-code-server recreates ~/workspace, ~/extensions and ~/data as root the same
# way, and hands them to abc only when it finds a new volume or a changed PUID. init-agents-md,
# init-extensions and init-vscode-settings write in them as abc and wait on this oneshot, so a
# directory the user deleted would otherwise come back unwritable: no AGENTS.md, a default
# workspace nobody can write to, no EnvHaven extension. Only the directory itself is handed
# back; what is inside belongs to the user (LinuxServer leaves the workspace's contents alone
# too), and chown -h, given a symlink, changes the link itself.
for dir in /config/workspace /config/extensions /config/data; do
    [ -e "$dir" ] && chown -h abc:abc "$dir"
done

exec /usr/local/lib/envhaven/as-abc /usr/local/lib/envhaven/envhaven-user-setup

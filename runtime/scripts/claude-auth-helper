#!/bin/sh
# Claude Code subscription auth helper for remote/container environments.
# Drives Anthropic's OAuth PKCE flow directly so the user pastes a short
# code (shown on the success page), not a localhost callback URL. Writes
# ~/.claude/.credentials.json in the format Claude Code expects.
#
# OAuth constants (CLIENT_ID, REDIRECT_URI, SCOPES) and the credentials
# file shape mirror Hermes' run_hermes_oauth_login_pure() in
# NousResearch/hermes-agent → agent/anthropic_adapter.py. That is the
# canonical reference for unofficial Claude Code OAuth — if Anthropic
# rotates any of these values or changes the response shape, check
# Hermes upstream for the updated values before guessing.

CLIENT_ID="9d1c250a-e61b-44d9-88ed-5944d1962f5e"
AUTHORIZE_URL="https://claude.ai/oauth/authorize"
TOKEN_URL="https://console.anthropic.com/v1/oauth/token"
REDIRECT_URI="https://console.anthropic.com/oauth/code/callback"
SCOPES="org:create_api_key user:profile user:inference"
BROWSER_HELPER="/app/code-server/lib/vscode/bin/helpers/browser.sh"
CREDS_FILE="$HOME/.claude/.credentials.json"

b64url() { base64 -w0 | tr '/+' '_-' | tr -d '='; }
urlenc() { jq -sRr @uri; }

VERIFIER=$(openssl rand 32 | b64url)
CHALLENGE=$(printf '%s' "$VERIFIER" | openssl dgst -sha256 -binary | b64url)

# Reuse verifier as state — Anthropic returns the auth code as <code>#<state>,
# so we get the verifier back and can confirm flow integrity.
AUTH_URL="$AUTHORIZE_URL?code=true"
AUTH_URL="$AUTH_URL&client_id=$CLIENT_ID"
AUTH_URL="$AUTH_URL&response_type=code"
AUTH_URL="$AUTH_URL&redirect_uri=$(printf '%s' "$REDIRECT_URI" | urlenc)"
AUTH_URL="$AUTH_URL&scope=$(printf '%s' "$SCOPES" | urlenc)"
AUTH_URL="$AUTH_URL&code_challenge=$CHALLENGE"
AUTH_URL="$AUTH_URL&code_challenge_method=S256"
AUTH_URL="$AUTH_URL&state=$VERIFIER"

cat << 'BANNER'

  ┌───────────────────────────────────────────────────┐
  │  Sign in to Claude (Pro/Max subscription):        │
  │                                                   │
  │  1. Click Open when prompted.                     │
  │  2. Authorize Claude Code for this workspace.     │
  │  3. Copy the code shown on the success page,      │
  │     then paste it here to finish.                 │
  └───────────────────────────────────────────────────┘

BANNER

if [ -x "$BROWSER_HELPER" ]; then
  printf "  Press Enter to start... "
  read -r _
  "$BROWSER_HELPER" "$AUTH_URL" >/dev/null 2>&1 &
else
  echo ""
  echo "  Open this URL in your browser:"
  echo ""
  echo "  $AUTH_URL"
  echo ""
fi

printf "  Paste code: "
read -r AUTH_CODE
if [ -z "${AUTH_CODE:-}" ]; then
  echo ""
  echo "  Cancelled."
  exit 1
fi

CODE=${AUTH_CODE%%#*}
STATE=${AUTH_CODE#*#}
[ "$STATE" = "$AUTH_CODE" ] && STATE=""

REQUEST_BODY=$(jq -n \
  --arg client_id "$CLIENT_ID" \
  --arg code "$CODE" \
  --arg state "$STATE" \
  --arg redirect_uri "$REDIRECT_URI" \
  --arg verifier "$VERIFIER" \
  '{grant_type:"authorization_code",
    client_id:$client_id, code:$code, state:$state,
    redirect_uri:$redirect_uri, code_verifier:$verifier}')

RESPONSE=$(curl -sS -X POST "$TOKEN_URL" \
  -H "Content-Type: application/json" \
  -H "User-Agent: claude-cli (external, cli)" \
  -d "$REQUEST_BODY")

ACCESS_TOKEN=$(printf '%s' "$RESPONSE" | jq -r '.access_token // empty')
REFRESH_TOKEN=$(printf '%s' "$RESPONSE" | jq -r '.refresh_token // empty')
EXPIRES_IN=$(printf '%s' "$RESPONSE" | jq -r '.expires_in // 3600')

if [ -z "$ACCESS_TOKEN" ]; then
  ERROR=$(printf '%s' "$RESPONSE" | jq -r '.error_description // .error // .')
  echo ""
  echo "  ✗ Login failed: $ERROR"
  echo "  Try again, or set ANTHROPIC_API_KEY as an alternative."
  echo ""
  exit 1
fi

NOW_MS=$(( $(date +%s) * 1000 ))
EXPIRES_AT_MS=$(( NOW_MS + EXPIRES_IN * 1000 ))

mkdir -p "$HOME/.claude"
EXISTING="{}"
[ -f "$CREDS_FILE" ] && EXISTING=$(cat "$CREDS_FILE")

printf '%s' "$EXISTING" | jq \
  --arg access "$ACCESS_TOKEN" \
  --arg refresh "$REFRESH_TOKEN" \
  --argjson expires_at "$EXPIRES_AT_MS" \
  '.claudeAiOauth = {
    accessToken: $access,
    refreshToken: $refresh,
    expiresAt: $expires_at,
    scopes: ["org:create_api_key","user:profile","user:inference"]
  }' > "$CREDS_FILE.tmp" && mv "$CREDS_FILE.tmp" "$CREDS_FILE"
chmod 600 "$CREDS_FILE"

echo ""
echo "  ✓ Login successful — starting Claude Code..."
echo ""
exec claude

#!/usr/bin/with-contenv bash

# Install Oh My Zsh on a fresh volume and configure the zsh customizations. s6 orders this
# oneshot after init-mods-end, so a mod a self-hoster adds through DOCKER_MODS has run first.
#
# code-server, sshd and the console all wait on this oneshot, and s6 never starts them
# once it fails. Each step below therefore reports its own failure and carries on: one
# odd dotfile must not leave the workspace with no way in.

ZSH_CUSTOM_DIR="/config/.oh-my-zsh/custom"
ENVHAVEN_ZSH="$ZSH_CUSTOM_DIR/envhaven.zsh"
ZSHENV="/config/.zshenv"

# Install an image-owned file without ever opening its destination. The parent walk,
# temporary file, and rename all run as abc: a persisted symlink can be replaced, but
# neither it nor an attacker-controlled ancestor can redirect a privileged write. A
# directory link that resolves inside HOME (say ~/.oh-my-zsh/custom kept in a dotfiles
# repo) is followed, and the file lands in the directory it names.
install_user_file() {
    local source=$1
    local destination=$2
    /usr/local/lib/envhaven/as-abc bash -c '
        set -euo pipefail
        source=$1
        destination=$2
        owner="$(id -u):$(id -g)"

        case "$destination" in
            "$HOME"/*) ;;
            *) printf "envhaven: refusing zsh destination outside HOME: %s\n" "$destination" >&2; exit 1 ;;
        esac
        if [[ -L "$HOME" || ! -d "$HOME" || $(stat -c "%u:%g" -- "$HOME") != "$owner" ]]; then
            printf "envhaven: refusing unsafe zsh HOME: %s\n" "$HOME" >&2
            exit 1
        fi

        parent=${destination%/*}
        relative=${parent#"$HOME"}
        relative=${relative#/}
        current=$HOME
        if [[ -n "$relative" ]]; then
            IFS=/ read -r -a parts <<< "$relative"
            for part in "${parts[@]}"; do
                [[ -n "$part" && "$part" != . && "$part" != .. ]] || exit 1
                current="$current/$part"
                if [[ -L "$current" ]]; then
                    link=$current
                    if ! current=$(realpath -e -- "$link") || [[ "$current" != "$HOME"/* ]]; then
                        printf "envhaven: refusing zsh directory link that does not resolve inside HOME: %s\n" "$link" >&2
                        exit 1
                    fi
                fi
                if [[ ! -e "$current" ]]; then
                    mkdir -- "$current"
                    chmod 755 "$current"
                elif [[ ! -d "$current" ]]; then
                    printf "envhaven: refusing non-directory zsh path: %s\n" "$current" >&2
                    exit 1
                fi
                if [[ $(stat -c "%u:%g" -- "$current") != "$owner" ]]; then
                    printf "envhaven: refusing zsh directory not owned by abc: %s\n" "$current" >&2
                    exit 1
                fi
            done
        fi
        parent=$current
        destination="$parent/${destination##*/}"

        if [[ -e "$destination" && ! -L "$destination" && ! -f "$destination" ]]; then
            printf "envhaven: refusing non-regular zsh destination: %s\n" "$destination" >&2
            exit 1
        fi
        tmp=$(mktemp "$parent/.envhaven-install.XXXXXX")
        trap '\''rm -f -- "$tmp"'\'' EXIT HUP INT TERM
        cat -- "$source" > "$tmp"
        chmod 644 "$tmp"
        sync -f "$tmp"
        mv -fT -- "$tmp" "$destination"
        tmp=""
        sync -f "$parent"
        trap - EXIT HUP INT TERM

        [[ -f "$destination" && ! -L "$destination" && $(stat -c "%u:%g" -- "$destination") == "$owner" ]]
    ' envhaven-install-user-file "$source" "$destination"
}

# Oh My Zsh ships in the image at a pinned commit (Dockerfile) and is copied, as abc, into a
# volume that has none. This replaces LinuxServer's code-server-zsh mod, which root fetched from
# the mod registry and ran at every start. A copy already on the volume stays the user's, and
# it is a git checkout, so `omz update` keeps working.
if [ ! -e /config/.oh-my-zsh ]; then
    if /usr/local/lib/envhaven/as-abc bash -c '
        set -e
        cp -a /usr/share/envhaven/oh-my-zsh /config/.oh-my-zsh
        [ -e /config/.zshrc ] || cp /config/.oh-my-zsh/templates/zshrc.zsh-template /config/.zshrc
    '; then
        echo "Installed Oh My Zsh to /config/.oh-my-zsh"
    else
        echo "ERROR: could not install Oh My Zsh" >&2
    fi
fi

# EnvHaven zsh customizations: image-owned like the theme below, refreshed on every boot,
# so an image update reaches existing workspaces (the aliases it carries follow the tool
# roster, and a copy-if-missing kept every older workspace on the roster it was created with).
if install_user_file /defaults/zshrc-additions "$ENVHAVEN_ZSH"; then
    echo "Installed EnvHaven zsh customizations to $ENVHAVEN_ZSH"
else
    echo "ERROR: could not install EnvHaven zsh customizations" >&2
fi

# Install the image-owned EnvHaven prompt theme. The custom hook selects it at
# shell load time only when oh-my-zsh's stock default is still active.
if ! install_user_file /defaults/envhaven.zsh-theme "$ZSH_CUSTOM_DIR/themes/envhaven.zsh-theme"; then
    echo "ERROR: could not install the EnvHaven zsh theme" >&2
fi

# Create .zshenv to set ZSH_DISABLE_COMPFIX BEFORE .zshrc is loaded
# .zshenv is always sourced first, before .zshrc
if ! /usr/local/lib/envhaven/as-abc grep -q "ZSH_DISABLE_COMPFIX" "$ZSHENV" 2>/dev/null; then
    if install_user_file /defaults/zshenv "$ZSHENV"; then
        echo "Created .zshenv with ZSH_DISABLE_COMPFIX"
    else
        echo "ERROR: could not install .zshenv" >&2
    fi
fi

# The last line of ~/.zshrc loads the credential store for zsh that never runs the
# drop-in above (envhaven-install-rc-hook says why). A fresh .zshrc is only written above,
# which is why this runs here rather than in init-user-config beside the bash hook; it runs
# the same way, as abc.
if ! /usr/local/lib/envhaven/as-abc /usr/local/lib/envhaven/envhaven-install-rc-hook zsh; then
    echo "ERROR: could not install the zsh credential store hook" >&2
fi

# Move credentials written by older images out of shell rc files before users or the
# console can observe them. The migration is idempotent and preserves manual exports.
# A failure is reported and startup continues. The console still never exposes two
# mutable stores: it repeats the marked-line migration before every credential change
# and refuses the change until that migration succeeds.
if ! /usr/local/lib/envhaven/as-abc /opt/envhaven/bin/envhaven-console --migrate-credentials; then
    echo "ERROR: EnvHaven credential migration failed; the console refuses credential changes until it succeeds" >&2
fi

echo "Zsh configuration completed"

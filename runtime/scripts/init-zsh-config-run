#!/usr/bin/with-contenv bash

# Configure zsh customizations AFTER oh-my-zsh mod has run
# This script waits for oh-my-zsh to be installed, then adds EnvHaven customizations

# LinuxServer code-server always uses 'abc' as the user (unlike openssh-server)
USERNAME="abc"
ZSH_CUSTOM_DIR="/config/.oh-my-zsh/custom"
ENVHAVEN_ZSH="$ZSH_CUSTOM_DIR/envhaven.zsh"
ZSHRC="/config/.zshrc"
ZSHENV="/config/.zshenv"
MAX_WAIT=120  # seconds; the zsh mod clones oh-my-zsh at boot, slower on cold networks

echo "Waiting for the zsh mod (oh-my-zsh + .zshrc)..."

# The mod creates the custom dir BEFORE it writes /config/.zshrc, and the theme swap
# below edits that file. Wait for the LAST artifact we depend on, not the first:
# racing the mod is how the theme swap silently missed on slow boots.
waited=0
while ! grep -q '^ZSH_THEME=' "$ZSHRC" 2>/dev/null && [ $waited -lt $MAX_WAIT ]; do
    sleep 1
    waited=$((waited + 1))
done

# Diagnose the exact thing we waited for: a timeout here means the ZSH_THEME line
# never appeared, so the theme swap below silently no-ops.
if ! grep -q '^ZSH_THEME=' "$ZSHRC" 2>/dev/null; then
    echo "WARNING: /config/.zshrc has no ZSH_THEME after ${MAX_WAIT}s; theme swap skipped"
fi

# The theme file is copied into the custom dir below, so ensure it exists regardless.
if [ ! -d "$ZSH_CUSTOM_DIR" ]; then
    mkdir -p "$ZSH_CUSTOM_DIR"
fi

# Copy EnvHaven zsh customizations if not already present
if [ ! -f "$ENVHAVEN_ZSH" ]; then
    cp /defaults/zshrc-additions "$ENVHAVEN_ZSH"
    echo "Installed EnvHaven zsh customizations to $ENVHAVEN_ZSH"
else
    echo "EnvHaven zsh customizations already present"
fi

# Install the EnvHaven prompt theme (image-owned; refreshed on image update) and make
# it the default. Only oh-my-zsh's stock default is ever replaced: a user-chosen
# ZSH_THEME is left alone.
mkdir -p "$ZSH_CUSTOM_DIR/themes"
cp /defaults/envhaven.zsh-theme "$ZSH_CUSTOM_DIR/themes/envhaven.zsh-theme"
if grep -q '^ZSH_THEME="robbyrussell"' "$ZSHRC" 2>/dev/null; then
    sed -i 's/^ZSH_THEME="robbyrussell"/ZSH_THEME="envhaven"/' "$ZSHRC"
    echo "Set ZSH_THEME to envhaven"
else
    echo "ZSH_THEME left alone: $(grep -o '^ZSH_THEME=.*' "$ZSHRC" 2>/dev/null || echo '.zshrc not present')"
fi

# Create .zshenv to set ZSH_DISABLE_COMPFIX BEFORE .zshrc is loaded
# .zshenv is always sourced first, before .zshrc
if [ ! -f "$ZSHENV" ] || ! grep -q "ZSH_DISABLE_COMPFIX" "$ZSHENV" 2>/dev/null; then
    cat > "$ZSHENV" << 'EOF'
# EnvHaven zsh environment
# Disable oh-my-zsh permission check (linuxserver container uses shared volumes)
ZSH_DISABLE_COMPFIX=true
EOF
    chown "$USERNAME:$USERNAME" "$ZSHENV"
    echo "Created .zshenv with ZSH_DISABLE_COMPFIX"
fi

# Ensure ownership is correct
chown -R "$USERNAME:$USERNAME" "/config/.oh-my-zsh" 2>/dev/null || true

echo "Zsh configuration completed"
